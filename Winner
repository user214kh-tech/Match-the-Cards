local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local rootPart = character:WaitForChild("HumanoidRootPart")

local seat = workspace:WaitForChild("Games"):WaitForChild("10"):WaitForChild("Chairs"):WaitForChild("Chair2"):WaitForChild("Seat")
local seat1 = workspace:WaitForChild("Games"):WaitForChild("10"):WaitForChild("Chairs"):WaitForChild("Chair1"):WaitForChild("Seat")

local seated = false
local timer = 0

local function sitDown()
    rootPart.CFrame = seat.CFrame + Vector3.new(0, 0.5, 0)
end

local function chair1Occupied()
    return seat1.Occupant ~= nil
end

sitDown()

while task.wait(0.1) do
    if humanoid.SeatPart == seat then
        if not seated then
            seated = true
            timer = 0
        end
        if chair1Occupied() then
            timer = timer + 0.1
            if timer >= 14 then
                game:GetService("TeleportService"):Teleport(game.PlaceId, LocalPlayer)
            end
        else
            timer = 0
        end
    else
        seated = false
        timer = 0
        sitDown()
    end
end
