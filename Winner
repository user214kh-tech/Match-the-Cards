local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local rootPart = character:WaitForChild("HumanoidRootPart")

local games = workspace:WaitForChild("Games")
local folders = {"10", "11"}
local currentIndex = 1

local function getSeat(folderName)
    return games:WaitForChild(folderName):WaitForChild("Chairs"):WaitForChild("Chair1"):WaitForChild("Seat")
end

local function sitDown(seat)
    rootPart.CFrame = seat.CFrame + Vector3.new(0, 0.5, 0)
end

local currentSeat = getSeat(folders[currentIndex])
sitDown(currentSeat)

while task.wait(0.1) do
    if humanoid.SeatPart ~= currentSeat then
        currentIndex = (currentIndex % #folders) + 1
        currentSeat = getSeat(folders[currentIndex])
        sitDown(currentSeat)
    end
end
